<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>KoylulerDoorStages</AssemblyName>
    <RootNamespace>KoylulerDoorStages</RootNamespace>
    <LangVersion>preview</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SurvivalcraftAPI.Survivalcraft" Version="1.9.5.1" />
    <PackageReference Include="HarmonyX" Version="2.16.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
